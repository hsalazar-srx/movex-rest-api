{
  "openapi": "3.0.1",
  "info": {
    "title": "Movex REST API",
    "description": "Config-driven REST API for M3 MOVEX transactions and workflows.",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Movex.API, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StringDateTimeStringInt32String<>f__AnonymousType33<>f__AnonymousType32"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/pool-stats": {
      "get": {
        "tags": [
          "Movex.API, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooleanConnectionPoolStatsDateTime<>f__AnonymousType34"
                }
              }
            }
          }
        }
      }
    },
    "/api/security/api-key/status": {
      "get": {
        "tags": [
          "Security"
        ],
        "summary": "Returns whether the primary API key is configured (does not reveal the key)",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/security/api-key/rotate": {
      "post": {
        "tags": [
          "Security"
        ],
        "summary": "Admin-only: Rotate the primary API key. Development only.\r\nRequires X-Admin-Key header to match configuration.\r\nGenerates a new 256-bit Base64 key, stores it via User Secrets, and returns it.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "style": "form",
            "schema": {
              "type": "string",
              "default": "Base64"
            }
          },
          {
            "name": "bytes",
            "in": "query",
            "style": "form",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 32
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
