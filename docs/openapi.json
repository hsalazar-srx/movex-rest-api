          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ConnectionPoolStats": {
        "type": "object",
        "properties": {
          "totalConnections": {
            "type": "integer",
            "format": "int32"
          },
          "availableConnections": {
            "type": "integer",
            "format": "int32"
          },
          "inUseConnections": {
            "type": "integer",
            "format": "int32"
          },
          "minPoolSize": {
            "type": "integer",
            "format": "int32"
          },
          "maxPoolSize": {
            "type": "integer",
            "format": "int32"
          }
