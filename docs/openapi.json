        },
        "additionalProperties": false
      },
      "StringInt32String<>f__AnonymousType33": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "nullable": true
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "API key required. Use the X-API-Key header.",
        "name": "X-API-Key",
        "in": "header"
      },
      "AdminKey": {
        "type": "apiKey",
        "description": "Admin key for rotation endpoints. Use the X-Admin-Key header.",
        "name": "X-Admin-Key",
        "in": "header"
