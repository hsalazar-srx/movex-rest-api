{
  "openapi": "3.0.1",
  "info": {
    "title": "Movex REST API",
    "description": "Config-driven REST API for M3 MOVEX transactions and workflows.",
    "version": "v1"
  },
  "paths": {
    "/api/parts/search-alias": {
      "get": {
        "tags": [
          "Db2Query"
        ],
        "summary": "Reverse alias lookup: customer part number (POPN) → Scanfil APAC ITNO(s).\r\n            \r\nQueries MVXCDTA.MITPOP WHERE MPPOPN = popn [AND MPE0PA = e0pa].\r\nReturns all matching ITNOs so the caller can apply full_match / partial_match / no_match logic.\r\n            \r\nNo M3 MI program supports this direction (MMS025MI.LstAlias is ITNO-first).",
        "parameters": [
          {
            "name": "cono",
            "in": "query",
            "description": "Company number (default: M3:DEFAULT_COMPANY from config)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "popn",
            "in": "query",
            "description": "Customer / external part number (MITPOP.MPPOPN). Required.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "e0pa",
            "in": "query",
            "description": "Optional partner/customer code filter (MITPOP.MPE0PA = OCUSMA.OKCUNO).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MitpopSearchResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MitpopSearchResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MitpopSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway"
          }
        }
      }
    },
    "/api/parts/next-sequence": {
      "get": {
        "tags": [
          "Db2Query"
        ],
        "summary": "Get the next available sequence number for a Scanfil APAC part number prefix.\r\n            \r\nQueries MAX(TRIM(MMITNO)) FROM MVXCDTA.MITMAS WHERE MMITNO LIKE prefix||'%'.\r\nReturns next_seq = (last 4-digit sequence found) + 1, or 1 if no matches exist.\r\n            \r\nPN format: LF{CUNO(2)}{commodity(2)}{seq(4)}.\r\n'LF' is the company prefix (Scanfil APAC legacy) — not a lead-free marker.",
        "parameters": [
          {
            "name": "cono",
            "in": "query",
            "description": "Company number (default: M3:DEFAULT_COMPANY from config)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefix",
            "in": "query",
            "description": "Part number prefix to scan (e.g. \"LFAP11\"). Required.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NextSequenceResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextSequenceResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextSequenceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway"
          }
        }
      }
    },
    "/api/customers/list": {
      "get": {
        "tags": [
          "Db2Query"
        ],
        "summary": "List active Movex customers (OCUSMA, OKSTAT='20') for ECN customer selection in Oskar.\r\n            \r\nReturns OKCUNO (2-char code embedded in Scanfil APAC part numbers) + OKCUNM (name).",
        "parameters": [
          {
            "name": "cono",
            "in": "query",
            "description": "Company number (default: M3:DEFAULT_COMPANY from config)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerListResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerListResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerListResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway"
          }
        }
      }
    },
