{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://localhost:3000",
    "https://example.com"
  ],
  "ApiKeys": {
    "Primary": "your-api-key",
    "Admin": "your-admin-key"
  },
  "ConnectionPool": {
    "MinSize": 2,
    "MaxSize": 10,
    "IdleTimeoutSeconds": 300,
    "AcquireTimeoutSeconds": 10,
    "ValidateOnAcquire": true
  },
  "M3_HOST": "150.3.2.100",
  "M3_PORT": "6300",
  "M3_USER": "your-username",
  "M3_PASSWORD": "your-password"
}