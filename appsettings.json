{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "MovexRestApi.Infrastructure.Http": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://localhost:3000",
    "https://example.com"
  ],
  "ApiKeys": {
    "Primary": "your-api-key",
    "Admin": "your-admin-key"
  },
  "ConnectionPool": {
    "MinSize": 2,
    "MaxSize": 10,
    "IdleTimeoutSeconds": 300,
    "AcquireTimeoutSeconds": 10,
    "ValidateOnAcquire": true
  },
  "M3": {
    "HOST": "150.3.2.100",
    "PORT": "6300",
    "USER": "your-username",
    "PASSWORD": "your-password",
    "DEFAULT_COMPANY": "300"
  }
}