{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MovexRestApi.Infrastructure.Http": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://localhost:5000",
    "https://example.com"
  ],
  "Swagger": {
    "Enabled": true,
    "Generate": false
  },
  "ApiKeys": {
    "Primary": "your-api-key",
    "Admin": "your-admin-key",
    "Wms": "your-wms-api-key",
    "WmsAllowedTransactions": [
      "PMS100MI/SelMaterials",
      "PPS001MI/Receipt"
    ]
  },
  "ConnectionPool": {
    "MinSize": 2,
    "MaxSize": 10,
    "IdleTimeoutSeconds": 300,
    "AcquireTimeoutSeconds": 10,
    "ValidateOnAcquire": true
  },
  "M3": {
    "HOST": "150.3.2.100",
    "PORT": "6300",
    "USER": "your-username",
    "PASSWORD": "your-password",
    "DEFAULT_COMPANY": "300"
  },
  "Db2": {
    "ConnectionString": "",
    "SchemaCmp100": "MVXCDTA",
    "SchemaCmp300": "MVXC300",
    "SchemaStargile100": "COMCDTA100",
    "SchemaStargile300": "COMCDTA300",
    "CommandTimeoutSeconds": 30
  }
}