<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ASP.NET Core IIS Module Configuration -->
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    
    <!-- ASP.NET Core Module Configuration -->
    <aspNetCore processPath="Movex.API.exe" 
               stdoutLogEnabled="true" 
               stdoutLogFile=".\logs\stdout" 
               hostingModel="outofprocess">
      <!-- Environment Variables (override with IIS Application Settings) -->
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <environmentVariable name="ASPNETCORE_URLS" value="http://+:5000" />
      </environmentVariables>
    </aspNetCore>

    <!-- Compilation settings -->
    <compilation debug="true" targetFramework="net8.0" />

    <!-- Prevent direct access to sensitive files -->
    <staticContent>
      <remove fileExtension=".json" />
      <remove fileExtension=".txt" />
      <mimeType fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Request filtering -->
    <security>
      <requestFiltering>
        <!-- Block access to configuration files -->
        <denyUrlSequences>
          <add sequence="appsettings" />
          <add sequence="web.config" />
          <add sequence="logs" />
          <add sequence="transactions" />
        </denyUrlSequences>
      </requestFiltering>
    </security>

    <!-- Logging configuration -->
    <httpLogging>
      <selectiveLogging logAllTuples="false" >
        <add tuple="UserName, UserAgent, Referer, Host, HttpStatus, HttpSubStatus, Win32Status, ServerPort, Method, UriStem, ProtocolVersion" />
      </selectiveLogging>
    </httpLogging>

    <!-- Response headers security -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <!-- Connection settings -->
    <connectionManagement>
      <add address="*" maxconnection="100" />
    </connectionManagement>

  </system.webServer>

  <!-- Application Configuration -->
  <appSettings>
    <!-- These should be set in IIS Application Settings instead for security -->
    <!-- M3 Connection -->
    <!-- 
    <add key="M3_HOST" value="150.3.2.100" />
    <add key="M3_PORT" value="6300" />
    <add key="M3_USER" value="SRXAPI" />
    <add key="M3_PASSWORD" value="API5apps" />
    <add key="M3_COMPANY" value="300" />
    -->
    <!-- API Keys -->
    <!-- 
    <add key="ApiKeys:Primary" value="your-generated-api-key" />
    <add key="ApiKeys:Admin" value="your-admin-key" />
    
    <!-- Logging -->
    <!-- 
    <add key="Logging:LogLevel:Default" value="Information" />
    <add key="Logging:LogLevel:Microsoft.AspNetCore" value="Warning" />
    -->
  </appSettings>

  <!-- Runtime configuration -->
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>

  <!-- Startup hints for IIS -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
