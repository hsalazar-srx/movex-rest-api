    {
      "name": "LstOperation",
      "description": "List all routing operations for a product structure. Call without OPNO and FDAT to use the 4-field key and return all ops from the start (source-verified 2026-05-08).",
      "httpMethod": "GET",
      "returnsList": true,
      "fields": [
        {
          "name": "CONO",
          "position": 1,
          "length": 3,
          "type": "numeric",
          "required": true,
          "description": "Company Number"
        },
        {
          "name": "FACI",
          "position": 2,
          "length": 3,
