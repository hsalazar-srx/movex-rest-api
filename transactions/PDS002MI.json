          "description": "Run Time (minutes)"
        },
        {
          "name": "SETI",
          "position": 5,
          "length": 9,
          "type": "text",
          "description": "Setup Time (minutes)"
        },
        {
          "name": "FDAT",
          "position": 6,
          "length": 8,
          "type": "numeric",
          "description": "From Date (YYYYMMDD)"
        },
        {
          "name": "TDAT",
          "position": 7,
          "length": 8,
          "type": "numeric",
          "description": "To Date (YYYYMMDD)"
        }
      ]
    },
