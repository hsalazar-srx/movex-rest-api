        {
          "name": "MSID",
          "position": 1,
          "length": 7,
          "type": "text",
          "description": "Message ID (blank = success)"
        },
        {
          "name": "MSDT",
          "position": 2,
          "length": 100,
          "type": "text",
          "description": "Error detail"
        }
      ]
    },
