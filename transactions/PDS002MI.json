      "responseFields": [
        { "name": "CONO", "position": 1,  "length": 3,  "startIndex": 16,  "type": "numeric", "description": "Company" },
        { "name": "FACI", "position": 2,  "length": 3,  "startIndex": 19,  "type": "text",    "description": "Facility" },
        { "name": "PRNO", "position": 3,  "length": 15, "startIndex": 22,  "type": "text",    "description": "Product number" },
        { "name": "STRT", "position": 4,  "length": 3,  "startIndex": 37,  "type": "text",    "description": "Product structure type" },
        { "name": "ITDS", "position": 5,  "length": 30, "startIndex": 40,  "type": "text",    "description": "Name" },
        { "name": "STRD", "position": 6,  "length": 8,  "startIndex": 70,  "type": "numeric", "description": "Structure date" },
        { "name": "ECVE", "position": 7,  "length": 4,  "startIndex": 78,  "type": "text",    "description": "Revision number" },
        { "name": "OPNO", "position": 8,  "length": 4,  "startIndex": 82,  "type": "numeric", "description": "Operation number" },
        { "name": "OPDS", "position": 9,  "length": 30, "startIndex": 86,  "type": "text",    "description": "Operation description" },
        { "name": "MTPL", "position": 10, "length": 15, "startIndex": 116, "type": "text",    "description": "Component number / work center" },
        { "name": "FDAT", "position": 11, "length": 8,  "startIndex": 131, "type": "numeric", "description": "From date (YYYYMMDD)" },
        { "name": "TDAT", "position": 12, "length": 8,  "startIndex": 139, "type": "numeric", "description": "To date (YYYYMMDD)" },
        { "name": "PLGR", "position": 13, "length": 8,  "startIndex": 156, "type": "text",    "description": "Work center" },
        { "name": "PLNM", "position": 14, "length": 36, "startIndex": 164, "type": "text",    "description": "Planning group name" },
        { "name": "DEPT", "position": 15, "length": 8,  "startIndex": 200, "type": "text",    "description": "Department" },
        { "name": "PITI", "position": 16, "length": 7,  "startIndex": 216, "type": "numeric", "description": "Run time" },
        { "name": "PTUN", "position": 17, "length": 1,  "startIndex": 223, "type": "text",    "description": "Time U/M" },
        { "name": "SETI", "position": 18, "length": 7,  "startIndex": 229, "type": "numeric", "description": "Setup time" },
        { "name": "SUBC", "position": 19, "length": 1,  "startIndex": 339, "type": "text",    "description": "Subcontract control" }
      ]
    },
    {
      "name": "UpdateOperation",
      "description": "Modify a routing operation on a product structure",
      "httpMethod": "POST",
      "returnsList": false,
      "fields": [
        { "name": "CONO", "position": 1,  "length": 3,  "startIndex": 16,  "type": "numeric", "required": true,  "description": "Company Number" },
        { "name": "FACI", "position": 2,  "length": 3,  "startIndex": 19,  "type": "text",    "required": true,  "description": "Facility" },
