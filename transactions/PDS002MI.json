{
  "program": "PDS002MI",
  "library": "MVXCOBJ",
  "description": "Product Structure Management — BOM Component and Routing Operations",
  "transactions": [
    {
      "name": "AddComponent",
      "description": "Add a BOM line (component + quantity + operation) to a product structure",
      "httpMethod": "POST",
      "returnsList": false,
      "fields": [
        { "name": "CONO", "position": 1,  "length": 3,  "startIndex": 16,  "type": "numeric", "required": true,  "description": "Company Number" },
        { "name": "FACI", "position": 2,  "length": 3,  "startIndex": 19,  "type": "text",    "required": true,  "description": "Facility" },
        { "name": "PRNO", "position": 3,  "length": 15, "startIndex": 22,  "type": "text",    "required": true,  "description": "Parent Product Number" },
        { "name": "STRT", "position": 4,  "length": 3,  "startIndex": 37,  "type": "text",    "required": true,  "description": "Product Structure Type" },
        { "name": "MSEQ", "position": 5,  "length": 4,  "startIndex": 40,  "type": "numeric", "required": true,  "description": "Sequence Number" },
        { "name": "OPNO", "position": 6,  "length": 4,  "startIndex": 44,  "type": "numeric", "required": false, "description": "Operation Number" },
        { "name": "FDAT", "position": 7,  "length": 8,  "startIndex": 48,  "type": "numeric", "required": false, "description": "From Date (YYYYMMDD)" },
        { "name": "MTPL", "position": 8,  "length": 15, "startIndex": 68,  "type": "text",    "required": true,  "description": "Component Item Number (MTNO)" },
        { "name": "WHLO", "position": 9,  "length": 3,  "startIndex": 107, "type": "text",    "required": false, "description": "Warehouse" },
        { "name": "CNQT", "position": 10, "length": 11, "startIndex": 120, "type": "text",    "required": true,  "description": "Quantity" },
        { "name": "CCQT", "position": 11, "length": 11, "startIndex": 131, "type": "text",    "required": false, "description": "Quantity on drawing" },
        { "name": "PEUN", "position": 12, "length": 3,  "startIndex": 142, "type": "text",    "required": false, "description": "Product engineering U/M" },
        { "name": "VAPC", "position": 13, "length": 5,  "startIndex": 155, "type": "numeric", "required": false, "description": "Option percentage" },
        { "name": "WAPC", "position": 14, "length": 5,  "startIndex": 160, "type": "numeric", "required": false, "description": "Normal waste percentage" },
        { "name": "BYPR", "position": 15, "length": 1,  "startIndex": 262, "type": "numeric", "required": false, "description": "By/co-product code" }
      ],
      "responseFields": [
        { "name": "MSID", "position": 1, "length": 7,   "type": "text", "description": "Message ID (blank = success)" },
        { "name": "MSDT", "position": 2, "length": 100, "type": "text", "description": "Error detail" }
      ]
    },
    {
      "name": "Delete",
      "description": "Delete a product structure component (by MSEQ) or operation (by OPNO)",
      "httpMethod": "POST",
      "returnsList": false,
      "fields": [
        { "name": "CONO", "position": 1, "length": 3,  "startIndex": 16, "type": "numeric", "required": true,  "description": "Company Number" },
        { "name": "FACI", "position": 2, "length": 3,  "startIndex": 19, "type": "text",    "required": true,  "description": "Facility" },
        { "name": "PRNO", "position": 3, "length": 15, "startIndex": 22, "type": "text",    "required": true,  "description": "Parent Product Number" },
        { "name": "STRT", "position": 4, "length": 3,  "startIndex": 37, "type": "text",    "required": true,  "description": "Product Structure Type" },
        { "name": "MSEQ", "position": 5, "length": 4,  "startIndex": 40, "type": "numeric", "required": false, "description": "Sequence Number (use for component delete)" },
        { "name": "OPNO", "position": 6, "length": 4,  "startIndex": 44, "type": "numeric", "required": false, "description": "Operation Number (use for operation delete)" },
        { "name": "FDAT", "position": 7, "length": 8,  "startIndex": 48, "type": "numeric", "required": false, "description": "From Date (YYYYMMDD)" }
      ],
      "responseFields": [
        {
          "name": "MSID",
          "position": 1,
          "length": 7,
          "type": "text",
          "description": "Message ID (blank = success)"
        },
        {
          "name": "MSDT",
          "position": 2,
          "length": 100,
          "type": "text",
          "description": "Error detail"
        }
      ]
    },
    {
      "name": "AddOperation",
      "description": "Add a new routing step to a product structure",
      "httpMethod": "POST",
      "returnsList": false,
      "fields": [
        { "name": "CONO", "position": 1,  "length": 3,  "startIndex": 16, "type": "numeric", "required": true,  "description": "Company Number" },
        { "name": "FACI", "position": 2,  "length": 3,  "startIndex": 19, "type": "text",    "required": true,  "description": "Facility" },
        { "name": "PRNO", "position": 3,  "length": 15, "startIndex": 22, "type": "text",    "required": true,  "description": "Product Number" },
        { "name": "STRT", "position": 4,  "length": 3,  "startIndex": 37, "type": "text",    "required": true,  "description": "Product Structure Type" },
        { "name": "MSEQ", "position": 5,  "length": 4,  "startIndex": 40, "type": "numeric", "required": false, "description": "Sequence Number (0 = auto-assign)" },
        { "name": "OPNO", "position": 6,  "length": 4,  "startIndex": 44, "type": "numeric", "required": true,  "description": "Operation Number" },
        { "name": "FDAT", "position": 7,  "length": 8,  "startIndex": 48, "type": "numeric", "required": false, "description": "From Date (YYYYMMDD)" },
        { "name": "PLGR", "position": 8,  "length": 8,  "startIndex": 83, "type": "text",    "required": false, "description": "Work Centre" },
        { "name": "OPDS", "position": 9,  "length": 30, "startIndex": 91, "type": "text",    "required": false, "description": "Operation Description" },
        { "name": "PITI", "position": 10, "length": 7,  "startIndex": 121,"type": "numeric", "required": false, "description": "Run Time (minutes)" },
        { "name": "SETI", "position": 11, "length": 7,  "startIndex": 133,"type": "numeric", "required": false, "description": "Setup Time (minutes)" }
      ],
      "responseFields": [
        { "name": "MSID", "position": 1, "length": 7,   "type": "text", "description": "Message ID (blank = success)" },
        { "name": "MSDT", "position": 2, "length": 100, "type": "text", "description": "Error detail" }
      ]
    },
    {
      "name": "LstOperation",
      "description": "List all routing operations for a product structure. Call without OPNO and FDAT to use the 4-field key and return all ops from the start (source-verified 2026-05-08).",
