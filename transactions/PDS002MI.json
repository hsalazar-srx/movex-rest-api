        { "name": "PITI", "position": 8,  "length": 7,  "startIndex": 121, "type": "numeric", "required": false, "description": "Run Time (minutes)" },
        { "name": "SETI", "position": 9,  "length": 7,  "startIndex": 133, "type": "numeric", "required": false, "description": "Setup Time (minutes)" }
      ],
      "responseFields": [
        { "name": "MSID", "position": 1, "length": 7,   "type": "text", "description": "Message ID (blank = success)" },
        { "name": "MSDT", "position": 2, "length": 100, "type": "text", "description": "Error detail" }
      ]
