          "length": 15,
          "type": "text",
          "required": true,
          "description": "Product Number"
        },
        {
          "name": "STRT",
          "position": 4,
          "length": 3,
          "type": "text",
          "required": true,
          "description": "Product Structure Type (001 = standard)"
