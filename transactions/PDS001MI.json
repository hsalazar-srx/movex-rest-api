{
  "program": "PDS001MI",
  "library": "MVXCOBJ",
  "description": "Product Structure Management — Add Product Header",
  "transactions": [
    {
      "name": "AddProduct",
      "description": "Create a new product/item header in Movex at APPROVED→IMPLEMENTED",
      "httpMethod": "POST",
      "returnsList": false,
      "fields": [
        {
          "name": "CONO",
          "position": 1,
          "length": 3,
          "type": "numeric",
          "required": true,
          "description": "Company Number"
        },
        {
          "name": "FACI",
          "position": 2,
          "length": 3,
          "type": "text",
          "required": true,
          "description": "Facility"
        },
        {
          "name": "PRNO",
          "position": 3,
          "length": 15,
          "type": "text",
          "required": true,
          "description": "Product Number"
        },
        {
          "name": "STRT",
          "position": 4,
          "length": 3,
          "type": "text",
          "required": true,
          "description": "Product Structure Type"
        },
        {
          "name": "ITDS",
          "position": 5,
          "length": 30,
          "type": "text",
          "required": false,
          "description": "Product Description"
        },
        {
          "name": "ECVE",
          "position": 6,
          "length": 4,
          "type": "text",
          "required": false,
          "description": "Revision Number"
        }
      ],
      "responseFields": [
        {
          "name": "MSID",
          "position": 1,
          "length": 7,
          "type": "text",
          "description": "Message ID (blank = success)"
        },
        {
          "name": "MSDT",
          "position": 2,
          "length": 100,
          "type": "text",
          "description": "Error detail"
        }
      ]
    }
  ]
}
