        {
          "name": "FUDS",
          "position": 5,
          "length": 60,
          "type": "text",
          "required": false,
          "description": "Description 2 (MITMAS.MMFUDS)"
        },
        {
          "name": "UNMS",
          "position": 6,
          "length": 3,
          "type": "text",
          "required": false,
          "description": "Basic Unit of Measure (MITMAS.MMUNMS) — defaults from item type if omitted"
        },
        {
          "name": "ITCL",
          "position": 7,
          "length": 5,
          "type": "text",
          "required": false,
          "description": "Product Group (MITMAS.MMITCL)"
        },
        {
          "name": "PRGP",
          "position": 8,
          "length": 3,
          "type": "text",
          "required": false,
          "description": "Procurement Group (MITMAS.MMPRGP)"
        },
        {
          "name": "STAT",
          "position": 9,
          "length": 2,
          "type": "text",
          "required": false,
          "description": "Status — 20=active; defaults to 20 if omitted"
        },
        {
          "name": "RESP",
          "position": 10,
          "length": 10,
          "type": "text",
          "required": false,
          "description": "Responsible Engineer (MITMAS.MMRESP)"
        },
        {
          "name": "BUYE",
          "position": 11,
          "length": 10,
          "type": "text",
          "required": false,
          "description": "Buyer (MITMAS.MMBUYE)"
