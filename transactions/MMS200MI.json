    {
      "name": "AddItmViaItmTyp",
      "description": "Add Item via Item Type — creates MITMAS record using an item type template (preferred for new items; pre-populates product group, procurement group, UoM and other defaults from the item type definition)",
      "httpMethod": "POST",
      "returnsList": false,
      "fields": [
        {
          "name": "CONO",
          "position": 1,
          "length": 3,
          "type": "numeric",
          "required": true,
          "description": "Company Number"
        },
        {
          "name": "ITTY",
          "position": 2,
          "length": 3,
          "type": "text",
          "required": true,
          "description": "Item Type — drives default population of classification fields"
        },
        {
          "name": "ITNO",
          "position": 3,
          "length": 15,
          "type": "text",
          "required": true,
          "description": "Item Number (MITMAS.MMITNO)"
        },
        {
          "name": "ITDS",
          "position": 4,
          "length": 30,
          "type": "text",
          "required": true,
          "description": "Item Name (MITMAS.MMITDS)"
