        {
          "name": "SUNO",
          "position": 12,
          "length": 10,
          "type": "text",
          "required": false,
          "description": "Primary Supplier Number (MITMAS.MMSUNO)"
        },
        {
          "name": "PUPR",
          "position": 13,
          "length": 17,
          "type": "decimal",
          "required": false,
          "description": "Purchase Price (MITMAS.MMPUPR)"
        },
        {
          "name": "LEA1",
          "position": 14,
          "length": 3,
          "type": "numeric",
          "required": false,
          "description": "Supply Lead Time days (MITMAS.MMLEA1)"
        },
        {
          "name": "ECVE",
          "position": 15,
          "length": 4,
          "type": "text",
          "required": false,
          "description": "Revision Number (MITMAS.MMECVE)"
        }
