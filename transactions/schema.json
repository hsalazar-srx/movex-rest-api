{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M3 Program Transaction Configuration Schema",
  "type": "object",
  "required": ["program", "transactions"],
  "properties": {
    "program": {
      "type": "string",
      "description": "M3 program name (e.g., MMS200MI, CRS610MI)"
    },
    "library": {
      "type": "string",
      "description": "M3 library name (e.g., MVXCOBJ, MVXLIB)",
      "default": "MVXCOBJ"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the program"
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Transaction name (e.g., GetItmBasic)"
          },
          "description": {
            "type": "string",
            "description": "Transaction description"
          },
          "fields": {
            "type": "array",
            "description": "Input field definitions",
            "items": {
              "$ref": "#/definitions/fieldConfig"
            }
          },
          "responseFields": {
            "type": "array",
            "description": "Output/response field definitions",
            "items": {
              "$ref": "#/definitions/responseFieldConfig"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "fieldConfig": {
      "type": "object",
      "required": ["name", "position", "length", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Field name (e.g., CONO, ITNO)"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "description": "Position in transaction string (1-based)"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "Field length in characters"
        },
        "type": {
          "type": "string",
          "enum": ["numeric", "text"],
          "description": "Field data type"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether field is required"
        },
        "description": {
          "type": "string",
          "description": "Human-readable field description"
        },
        "rightAlign": {
          "type": "boolean",
          "default": false,
          "description": "Text fields only: pad with leading spaces instead of trailing ones (e.g. right-justified PO numbers)"
        }
      }
    },
    "responseFieldConfig": {
      "type": "object",
      "required": ["name", "position", "length", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Output field name"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "description": "Position in response string (1-based)"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "Field length in characters"
        },
        "type": {
          "type": "string",
          "enum": ["text", "numeric", "integer", "decimal", "date", "boolean"],
          "description": "Field data type for parsing"
        },
        "description": {
          "type": "string",
          "description": "Human-readable field description"
        },
        "startIndex": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional absolute start position (1-based) for field extraction, independent of sequential position order"
        }
      }
    }
  }
}
